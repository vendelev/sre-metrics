{
  "schemaVersion": "v6",
  "name": "mis-login-outcomes",
  "tags": [
    {
      "key": "application",
      "value": "mis-login"
    }
  ],
  "spec": {
    "display": {
      "name": "Вход МИС: исходы сценариев",
      "description": "Сценарии входа МИС: исходные OTLP-метрики в SigNoz."
    },
    "duration": "1h",
    "refreshInterval": "1m",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "environment",
          "display": {
            "name": "Окружение"
          },
          "defaultValue": "development",
          "allowMultiple": false,
          "allowAllValue": false,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "environment",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "node",
          "display": {
            "name": "Нода"
          },
          "defaultValue": "node-1",
          "allowMultiple": false,
          "allowAllValue": false,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "node",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "guide": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Как читать"
          },
          "plugin": {
            "kind": "signoz/TextPanel",
            "spec": {
              "mode": "markdown",
              "text": "Считаются завершённые сценарии, а не HTTP-запросы.\n\n- **Отказы** — окончательный штатный отказ: нет прав или учётная запись отключена. Неверный пароль с возможностью повторить ввод не завершает сценарий.\n- **Успехи** — МИС восстановила сессию, разрешила доступ и сформировала защищённую страницу.\n- **Технические ошибки** — подтверждённый сбой, прервавший вход.\n- **Неизвестный исход** — результат не получен до срока ожидания: 15 минут от начала, а без начала — от первого получения события сервисом. Это не доказательство ошибки входа.\n\nОтказы и неизвестные исходы исключены из SLI. Приросты — оценки, а не точный журнал; возможны дробные значения. Нет данных — не ноль. Накопления процесса сбрасываются при перезапуске."
            }
          },
          "queries": []
        }
      },
      "rejected": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Отказы",
            "description": "Оценка числа завершений за выбранный диапазон дашборда."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "mis.login.scenarios.completed",
                        "temporality": "Cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "environment = '$environment' AND node = '$node' AND outcome = 'rejected'"
                    },
                    "legend": "Отказы",
                    "disabled": false
                  }
                }
              }
            }
          ]
        }
      },
      "success": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Успехи",
            "description": "Оценка числа завершений за выбранный диапазон дашборда."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "mis.login.scenarios.completed",
                        "temporality": "Cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "environment = '$environment' AND node = '$node' AND outcome = 'success'"
                    },
                    "legend": "Успехи",
                    "disabled": false
                  }
                }
              }
            }
          ]
        }
      },
      "technical_error": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Технические ошибки",
            "description": "Оценка числа завершений за выбранный диапазон дашборда."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "mis.login.scenarios.completed",
                        "temporality": "Cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "environment = '$environment' AND node = '$node' AND outcome = 'technical_error'"
                    },
                    "legend": "Технические ошибки",
                    "disabled": false
                  }
                }
              }
            }
          ]
        }
      },
      "unknown": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Неизвестный исход",
            "description": "Оценка числа завершений за выбранный диапазон дашборда."
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "stepInterval": 60,
                    "aggregations": [
                      {
                        "metricName": "mis.login.scenarios.completed",
                        "temporality": "Cumulative",
                        "timeAggregation": "increase",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "environment = '$environment' AND node = '$node' AND outcome = 'unknown'"
                    },
                    "legend": "Неизвестный исход",
                    "disabled": false
                  }
                }
              }
            }
          ]
        }
      },
      "recent": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Завершения за скользящие 5 минут",
            "description": "Каждая точка — оценка прироста за предшествующие 5 минут."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "step_after",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "sum by (environment, node) (increase({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"rejected\"}[5m]))",
                          "legend": "Отказы",
                          "disabled": false,
                          "step": 60
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "sum by (environment, node) (increase({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"success\"}[5m]))",
                          "legend": "Успехи",
                          "disabled": false,
                          "step": 60
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "C",
                          "query": "sum by (environment, node) (increase({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"technical_error\"}[5m]))",
                          "legend": "Технические ошибки",
                          "disabled": false,
                          "step": 60
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "D",
                          "query": "sum by (environment, node) (increase({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"unknown\"}[5m]))",
                          "legend": "Неизвестный исход",
                          "disabled": false,
                          "step": 60
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "counters": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Текущие накопленные счётчики по исходам",
            "description": "Значения процесса сбрасываются при перезапуске. Старые серии экземпляров могут временно сохраняться."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "step_after",
                "fillMode": "none"
              },
              "axes": {
                "softMin": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "sum by (environment, node) ({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"rejected\"})",
                          "legend": "Отказы",
                          "disabled": false,
                          "step": 60
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "sum by (environment, node) ({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"success\"})",
                          "legend": "Успехи",
                          "disabled": false,
                          "step": 60
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "C",
                          "query": "sum by (environment, node) ({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"technical_error\"})",
                          "legend": "Технические ошибки",
                          "disabled": false,
                          "step": 60
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "D",
                          "query": "sum by (environment, node) ({\"mis.login.scenarios.completed\",environment=\"$environment\",node=\"$node\",outcome=\"unknown\"})",
                          "legend": "Неизвестный исход",
                          "disabled": false,
                          "step": 60
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/guide"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/rejected"
              }
            },
            {
              "x": 3,
              "y": 8,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/success"
              }
            },
            {
              "x": 6,
              "y": 8,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/technical_error"
              }
            },
            {
              "x": 9,
              "y": 8,
              "width": 3,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/unknown"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/recent"
              }
            },
            {
              "x": 0,
              "y": 20,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/counters"
              }
            }
          ]
        }
      }
    ]
  }
}

<clickhouse>
    <!-- Отдельная однокопийная БД SigNoz. Keeper встроен в процесс ClickHouse. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="1" />
        <errorlog remove="1" />
    </logger>
    <listen_host replace="1">0.0.0.0</listen_host>
    <max_server_memory_usage>1207959552</max_server_memory_usage>
    <max_concurrent_queries>16</max_concurrent_queries>
    <mark_cache_size>33554432</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <background_pool_size>4</background_pool_size>
    <background_schedule_pool_size>8</background_schedule_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_distributed_schedule_pool_size>2</background_distributed_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <remote_servers replace="1">
        <cluster>
            <shard>
                <replica><host>signoz-clickhouse</host><port>9000</port></replica>
            </shard>
        </cluster>
    </remote_servers>
    <macros><shard>01</shard><replica>01</replica></macros>
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <raft_logs_level>warning</raft_logs_level>
            <snapshots_to_keep>2</snapshots_to_keep>
        </coordination_settings>
        <raft_configuration>
            <server><id>1</id><hostname>signoz-clickhouse</hostname><port>9234</port></server>
        </raft_configuration>
    </keeper_server>
    <zookeeper><node><host>127.0.0.1</host><port>9181</port></node></zookeeper>
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>
    <user_defined_executable_functions_config>/etc/clickhouse-server/functions.xml</user_defined_executable_functions_config>
    <query_log remove="1" />
    <query_thread_log remove="1" />
    <query_views_log remove="1" />
    <query_metric_log remove="1" />
    <metric_log remove="1" />
    <asynchronous_metric_log remove="1" />
    <part_log remove="1" />
    <text_log remove="1" />
    <trace_log remove="1" />
    <error_log remove="1" />
    <processors_profile_log remove="1" />
    <latency_log remove="1" />
</clickhouse>

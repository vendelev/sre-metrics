{
  "id": null,
  "uid": "auth-login-attempts",
  "title": "Авторизация: успехи и ошибки",
  "description": "Результаты авторизации отдельно по application: enterprise или auth-svc. Этапы разных приложений не суммируются. Auth-сервис пока не инструментирован. SLI OAuth callback применим к enterprise; история без application не включается.",
  "tags": ["auth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "templating": {
    "list": [{
      "name": "application",
      "label": "Приложение",
      "type": "custom",
      "query": "enterprise,auth-svc",
      "current": { "selected": true, "text": "enterprise", "value": "enterprise" },
      "options": [
        { "selected": true, "text": "enterprise", "value": "enterprise" },
        { "selected": false, "text": "auth-svc", "value": "auth-svc" }
      ],
      "multi": false,
      "includeAll": false,
      "hide": 0
    }]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Успешные входы за выбранный период (оценка)",
      "description": "Оценка прироста счётчика за выбранный период с учётом сбросов. Из-за экстраполяции Prometheus значение может быть дробным; это не точный журнал событий.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(auth_login_attempts_total{application=\"$application\",result=\"success\"}[$__range]))",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 2, "min": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "Накопленные счётчики результатов авторизации",
      "description": "Сумма текущих счётчиков по всем нодам и способам входа отдельно для каждого результата, без rate и усреднения. При перезапуске Go-сервиса его счётчик сбрасывается; сумма может уменьшиться. Отсутствие данных не подменяется нулём.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (auth_login_attempts_total{application=\"$application\"})",
          "legendFormat": "{{result}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [
            { "id": "displayName", "value": "Успешно" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
          ] },
          { "matcher": { "id": "byName", "options": "technical_error" }, "properties": [
            { "id": "displayName", "value": "Техническая ошибка" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] },
          { "matcher": { "id": "byName", "options": "user_rejected" }, "properties": [
            { "id": "displayName", "value": "Ожидаемый отказ" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
          ] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 3,
      "title": "Результаты авторизации за последние 5 минут (оценка)",
      "description": "Прирост за скользящее окно 5 минут с учётом сбросов счётчика. Один вход остаётся в окне несколько минут. Из-за экстраполяции значение может быть дробным; это не число входов в отдельную календарную минуту.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(auth_login_attempts_total{application=\"$application\"}[5m]))",
          "legendFormat": "{{result}}",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [
            { "id": "displayName", "value": "Успешно" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
          ] },
          { "matcher": { "id": "byName", "options": "technical_error" }, "properties": [
            { "id": "displayName", "value": "Техническая ошибка" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] },
          { "matcher": { "id": "byName", "options": "user_rejected" }, "properties": [
            { "id": "displayName", "value": "Ожидаемый отказ" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
          ] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 4,
      "title": "Технические ошибки за выбранный период (оценка)",
      "description": "Сетевые сбои, ошибки зависимостей и сохранения сессии, invalid_client, server_error и неизвестные OAuth-ошибки. Данные появились только после включения учёта ошибок. increase даёт оценку, не точный журнал.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "sum(increase(auth_login_attempts_total{application=\"$application\",result=\"technical_error\"}[$__range]))",
        "instant": true, "range": false, "editorMode": "code"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 2, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "none", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"
      }
    },
    {
      "id": 5,
      "title": "Ожидаемые отказы за выбранный период (оценка)",
      "description": "Неверные данные, отключённый пользователь, отсутствие прав, access_denied и invalid_grant. Не входят в знаменатель SLI. Отказы на странице Auth-сервиса без callback в МИС не видны.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "sum(increase(auth_login_attempts_total{application=\"$application\",result=\"user_rejected\"}[$__range]))",
        "instant": true, "range": false, "editorMode": "code"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 2, "min": 0, "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "none", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"
      }
    },
    {
      "id": 6,
      "title": "SLI OAuth callback за выбранный период (для enterprise)",
      "description": "success / (success + technical_error), только flow=oauth_callback. Ожидаемые отказы исключены. Нет учитываемых попыток — нет данных, не 100%. История до включения ошибок неполная, поэтому для оценки используйте период после развёртывания.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 5 },
      "targets": [{
        "refId": "A",
        "expr": "100 * sum(increase(auth_login_attempts_total{application=\"$application\",flow=\"oauth_callback\",result=\"success\"}[$__range])) / (sum(increase(auth_login_attempts_total{application=\"$application\",flow=\"oauth_callback\",result=~\"success|technical_error\"}[$__range])) > 0)",
        "instant": true, "range": false, "editorMode": "code"
      }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "noValue": "Нет учитываемых попыток" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"
      }
    }
  ]
}

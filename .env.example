# Скопируйте в .env перед запуском docker compose. Реальный .env не хранится в Git.
# Адрес Collector ниже доступен внутри Compose-сети; для запуска на хосте замените его.

# HTTP и лимиты хранения.
USER_LOGIN_LISTEN_ADDR=:8080
USER_LOGIN_MAX_SCENARIOS=10000
USER_LOGIN_MAX_EVENTS_PER_SCENARIO=32
USER_LOGIN_MAINTENANCE_INTERVAL=1s
USER_LOGIN_HTTP_READ_HEADER_TIMEOUT=1s
USER_LOGIN_HTTP_READ_TIMEOUT=2s
USER_LOGIN_HTTP_WRITE_TIMEOUT=2s
USER_LOGIN_HTTP_IDLE_TIMEOUT=30s
# Должен укладываться в stop_grace_period контейнера (сейчас 15s).
USER_LOGIN_SHUTDOWN_TIMEOUT=10s

# Экспорт метрик: стандартные переменные SDK. Длительности здесь — целые миллисекунды, без суффикса.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=2000
# Накопление с начала работы процесса требуется контрактом метрик и текущими расчётами SLI.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=2000
# Необязательный путь к PEM-файлу доверенного CA внутри контейнера (добавьте read-only mount в Compose).
# OTEL_EXPORTER_OTLP_METRICS_CERTIFICATE=/etc/ssl/certs/collector-ca.pem
# Общие OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_TIMEOUT и OTEL_EXPORTER_OTLP_CERTIFICATE
# также поддерживаются SDK, но соответствующие OTEL_EXPORTER_OTLP_METRICS_* имеют приоритет.

# Лимит рядов на инструмент; по умолчанию SDK использует 2000.
# Слишком малое значение объединяет ряды в overflow и нарушает расчёт SLI.
# OTEL_GO_X_CARDINALITY_LIMIT=2000

# Стандартные настройки Resource OpenTelemetry.
OTEL_SERVICE_NAME=mis-login-observability
OTEL_RESOURCE_ATTRIBUTES="service.namespace=sptr,service.instance.id=user-login-local-1,host.name=node-1,deployment.environment.name=development"
# Задавайте новый уникальный ID для каждого независимого экземпляра состояния; не копируйте ID между репликами.
